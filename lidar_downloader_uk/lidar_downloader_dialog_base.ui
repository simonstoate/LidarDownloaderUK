<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>LidarDownloaderDockWidgetBase</class>
 <widget class="QDockWidget" name="LidarDownloaderDockWidgetBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>340</width>
    <height>520</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>LIDAR Downloader UK</string>
  </property>
  <widget class="QWidget" name="dockWidgetContents">
   <layout class="QVBoxLayout" name="layMain">
    <item>
     <widget class="QgsCollapsibleGroupBox" name="grpTiles">
      <property name="title">
       <string>1. Choose your area</string>
      </property>
      <layout class="QVBoxLayout" name="layTiles">
       <item>
        <widget class="QCheckBox" name="chkShowGrid">
         <property name="text">
          <string>Show OSGB 5 km grid</string>
         </property>
         <property name="toolTip">
          <string>The grid of 5 km tiles the data comes in, shaded for the chosen dataset (see Downloaded, under Download folder): the tiles of it you have downloaded and, if ticked in step 2, the tiles in view still to download. Squares with no data from any source (mostly sea, or Northern Ireland) have only a faint outline.</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layGoTo">
         <item>
          <widget class="QLineEdit" name="leGoTo">
           <property name="placeholderText">
            <string>Go to: place, postcode or grid ref</string>
           </property>
           <property name="clearButtonEnabled">
            <bool>true</bool>
           </property>
           <property name="toolTip">
            <string>A place name, a postcode, an OS grid reference (SU, SU12, SU 1427, SU 14567 27890, SU12NE) or an easting and northing (414360, 130135). Zooms there and adds the tiles covering it to the selection. Postcodes and places are looked up with postcodes.io (Royal Mail / OS open data).</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnGoTo">
           <property name="text">
            <string>Go</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layPick">
         <item>
          <widget class="QToolButton" name="btnPickTiles">
           <property name="toolTip">
            <string>Pick tiles on the map: click a tile to select it, or drag a box to select every tile under it. To keep what's already selected, hold Shift or Ctrl: with either, a click adds the tile (or removes it if it's selected); a box adds with Shift and removes with Ctrl. QGIS's own selection tools work the same way on the grid.</string>
           </property>
           <property name="checkable">
            <bool>true</bool>
           </property>
           <property name="iconSize">
            <size>
             <width>24</width>
             <height>24</height>
            </size>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="btnDeselect">
           <property name="toolTip">
            <string>Deselect all the tiles</string>
           </property>
           <property name="iconSize">
            <size>
             <width>24</width>
             <height>24</height>
            </size>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="lblPickHint">
           <property name="text">
            <string>Pick tiles (Shift or Ctrl adds more)</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layCrop">
         <item>
          <widget class="QCheckBox" name="chkCrop">
           <property name="text">
            <string>Crop to</string>
           </property>
           <property name="toolTip">
            <string>Load, and save mosaics, cut to the polygons of the layer chosen beside it (its selected features if it has any), such as a site boundary: the tiles under it are joined into a mosaic and cropped to its shape. Ticking it selects the tiles beneath the layer.</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="lblTileCount">
         <property name="text">
          <string>No tiles selected yet</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QgsCollapsibleGroupBox" name="grpDataset">
      <property name="title">
       <string>2. Choose the data</string>
      </property>
      <layout class="QVBoxLayout" name="layDataset">
       <item>
        <widget class="QLabel" name="lblAvailability">
         <property name="text">
          <string/>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chkCoverage">
         <property name="text">
          <string>Also shade tiles available to download</string>
         </property>
         <property name="toolTip">
          <string>Also shade, in blue, the tiles in the map view that have this dataset but haven't been downloaded yet (with up to 1,600 tiles in view: zoom in if there are more)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblCoverageNote">
         <property name="text">
          <string/>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="indent">
          <number>20</number>
         </property>
         <property name="visible">
          <bool>false</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QgsCollapsibleGroupBox" name="grpDownload">
      <property name="title">
       <string>3. Download</string>
      </property>
      <layout class="QVBoxLayout" name="layDownload">
       <item>
        <layout class="QHBoxLayout" name="layDownloadButtons">
         <item>
          <widget class="QPushButton" name="btnDownloadTiles">
           <property name="text">
            <string>Download selected tiles</string>
           </property>
           <property name="default">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnCancel">
           <property name="text">
            <string>Cancel</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layAfterDownload">
         <item>
          <widget class="QLabel" name="lblAfterDownload">
           <property name="text">
            <string>When downloaded:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="cboAfterDownload">
           <property name="toolTip">
            <string>What happens to the tiles when the download finishes</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QPushButton" name="btnResume">
         <property name="text">
          <string>Resume unfinished downloads</string>
         </property>
         <property name="visible">
          <bool>false</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QProgressBar" name="progressBar">
         <property name="value">
          <number>0</number>
         </property>
         <property name="visible">
          <bool>false</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblStatus">
         <property name="text">
          <string/>
         </property>
         <property name="visible">
          <bool>false</bool>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QgsCollapsibleGroupBox" name="grpUse">
      <property name="title">
       <string>4. Use downloaded tiles</string>
      </property>
      <layout class="QVBoxLayout" name="layUse">
       <item>
        <layout class="QHBoxLayout" name="layUseRow1">
         <item>
          <widget class="QPushButton" name="btnLoadSelected">
           <property name="text">
            <string>Load selected</string>
           </property>
           <property name="toolTip">
            <string>Add the selected tiles of the chosen dataset to the project, a layer per 5 km tile (one area cropped to its shape when "Crop to" is ticked), then deselect the tiles</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnCreateVRT">
           <property name="text">
            <string>Create mosaic...</string>
           </property>
           <property name="toolTip">
            <string>Join the selected tiles into one mosaic, cropped when "Crop to" is ticked: a temporary one, gone when QGIS closes, or saved as a VRT (a small file that reads the tiles) or a GeoTIFF copy. Not for point clouds or oblique photos: they load as downloaded.</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layUseRow2">
         <item>
          <widget class="QPushButton" name="btnSurveyDates">
           <property name="text">
            <string>Survey dates</string>
           </property>
           <property name="toolTip">
            <string>On or off for the selected tiles: when the ground in each was actually flown (England's Composite DTM / DSM and SurfZone DEM: the surveys merged into the tile, from the survey file that comes with it), a layer per tile, coloured by year</string>
           </property>
           <property name="checkable">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QgsCollapsibleGroupBox" name="grpFolder">
      <property name="title">
       <string>Download folder</string>
      </property>
      <property name="collapsed">
       <bool>true</bool>
      </property>
      <layout class="QVBoxLayout" name="layFolder">
       <item>
        <layout class="QHBoxLayout" name="layDir">
         <item>
          <widget class="QLineEdit" name="leDownloadDir"/>
         </item>
         <item>
          <widget class="QPushButton" name="btnBrowse">
           <property name="text">
            <string>Browse...</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnOpenFolder">
           <property name="text">
            <string>Open</string>
           </property>
           <property name="toolTip">
            <string>Open the download folder in your file manager</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layShaded">
         <item>
          <widget class="QLabel" name="lblShaded">
           <property name="text">
            <string>Downloaded:</string>
           </property>
           <property name="toolTip">
            <string>What's in the download folder, with how many tiles of each. The grid is shaded for the one chosen here; it also follows the dataset chosen in step 2.</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QPushButton" name="btnMyDownloads">
         <property name="text">
          <string>My downloads...</string>
         </property>
         <property name="toolTip">
          <string>Everything in the download folder: space per survey; show on the grid, load, open or delete; and the zip files (delete them after extracting, or tidy them up)</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <widget class="QgsCollapsibleGroupBox" name="grpLegend">
      <property name="title">
       <string>Legend</string>
      </property>
      <property name="collapsed">
       <bool>true</bool>
      </property>
      <property name="visible">
       <bool>false</bool>
      </property>
      <layout class="QVBoxLayout" name="layLegend">
       <item>
        <widget class="QLabel" name="lblLegend">
         <property name="toolTip">
          <string>How the grid is shaded: which tiles you have downloaded for the chosen dataset</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <item>
     <spacer name="spacerBottom">
      <property name="orientation">
       <enum>Qt::Vertical</enum>
      </property>
      <property name="sizeHint" stdset="0">
       <size>
        <width>20</width>
        <height>0</height>
       </size>
      </property>
     </spacer>
    </item>
   </layout>
  </widget>
 </widget>
 <customwidgets>
  <customwidget>
   <class>QgsCollapsibleGroupBox</class>
   <extends>QGroupBox</extends>
   <header>qgscollapsiblegroupbox.h</header>
   <container>1</container>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
